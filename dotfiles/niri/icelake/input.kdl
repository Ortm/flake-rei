input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle"
            rules "evdev"
            model "pc105"
        }
    }
    touchpad {
        tap
        dwt
        dwtp

        drag true
        drag-lock
        click-method "clickfinger"
        tap-button-map "left-right-middle"

        natural-scroll
        accel-speed 0
        accel-profile "flat"
        
        scroll-factor 1.0
        scroll-method "two-finger"
        
        disabled-on-external-mouse
    }
}
